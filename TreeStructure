//component.jsx
import { useState } from "react";

export default function Component({ TreeViewObj }) {
  const [expandedNodes, setExpandedNodes] = useState({});

  const handleToggle = (node) => {
    setExpandedNodes((prev) => ({
      ...prev,
      [node]: !prev[node],
    }));
  };

  console.log("expandedNodes: ", expandedNodes);

  return (
    <div>
      {TreeViewObj.map((key, index) => (
        <div key={index} style={{ marginLeft: "20px" }}>
          <p
            style={{ cursor: "pointer", userSelect: "none" }}
            onClick={() => handleToggle(key.node)}
          >
            {key.node}
          </p>
          {expandedNodes[key.node] && key.children.length > 0 ? (
            <Component TreeViewObj={key.children} />
          ) : null}
        </div>
      ))}
    </div>
  );
}


