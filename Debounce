const printLogs = () => {
  console.log("writing something");
}

const myDebounce = (func, delay) => {
    let timeoutId;
    return (...args) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
            func.apply(this, args);
        }, delay);
    };
};

const betterFunction = myDebounce(printLogs, 300);
