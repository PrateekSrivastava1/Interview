let counter = 0;

const printLogs = () => {
  console.log("writing something");
}

const debounce = (fn, delay) => {
  let timer;
  return function() {
    let context = this, args = arguments;
    clearTimeout(timer);
    timer = setTimeout(() => {
      fn.apply(context, args);
    }, delay);
  }
}

const betterFunction = debounce(printLogs, 300);
