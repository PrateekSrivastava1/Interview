const curry = (fn) => {
  return curried = (...args) => {
    console.log(fn.length, " nums: ", args.length);
    if(fn.length !== args.length) return curried.bind(null, ...args);
    return fn(...args);
  }
}


const total = (x, y, z) => x + y + z;
const curriedTotal = curry(total);
console.log(curriedTotal(10)(20)(30));
